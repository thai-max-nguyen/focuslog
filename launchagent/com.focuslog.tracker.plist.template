<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.focuslog.tracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>PYTHON_PATH</string>
        <string>-m</string>
        <string>tracker.main</string>
    </array>
    <key>WorkingDirectory</key>
    <string>FOCUSLOG_DIR</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>FOCUSLOG_DATA/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>FOCUSLOG_DATA/stderr.log</string>
</dict>
</plist>
